Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(includes|database|archives|game|\.cursor|\.tools)(/|$) - [F,L]
    RewriteRule ^(README\.md|\.gitignore|router\.php)$ - [F,L]

    RewriteRule ^kunstwerken/?$ kunstwerken.php [L,QSA]
    RewriteRule ^kunstwerken/([a-z0-9-]+)/?$ kunstwerk.php?slug=$1 [L,QSA]
    RewriteRule ^afrekenen/?$ afrekenen.php [L,QSA]
    RewriteRule ^over/?$ over.php [L,QSA]
    RewriteRule ^opdrachten/?$ opdrachten.php [L,QSA]
    RewriteRule ^contact/?$ contact.php [L,QSA]

    ErrorDocument 404 /404.php
</IfModule>

SetEnvIf Request_URI "^/play/" play_assets

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN" env=!play_assets
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_mime.c>
    AddType application/octet-stream .apk .whl .data
    AddType application/wasm .wasm
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>
